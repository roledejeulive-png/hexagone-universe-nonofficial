<section class="phase-pot">
  <h2>
    {{localize "HEXAGON.Initiative.Pot"}}
    <em>{{bloc.restant}} / {{bloc.pot.total}}</em>
  </h2>

  <p class="phase-aide">{{localize "HEXAGON.Initiative.AidePot"}}</p>
  {{#if fractionnementAutorise}}
  <p class="phase-aide">{{localize "HEXAGON.Initiative.AideFraction"}}</p>
  {{/if}}
  {{#if bloc.clos}}
  <p class="phase-aide phase-clos">{{localize "HEXAGON.Initiative.TourClos"}}</p>
  {{/if}}

  <ul class="phase-repartition">
    {{#each bloc.repartition}}
    <li>
      <span class="phase-nom">{{this.nom}}</span>
      <span class="phase-compteur">
        <button type="button" data-action="ajusterPart" data-groupe="{{this.groupe}}" data-combattant="{{this.id}}" data-delta="-1" title="{{localize 'HEXAGON.Valeur.Diminuer'}}">−</button>
        <b>{{this.part}}</b>
        <button type="button" data-action="ajusterPart" data-groupe="{{this.groupe}}" data-combattant="{{this.id}}" data-delta="1" title="{{localize 'HEXAGON.Valeur.Augmenter'}}">+</button>
      </span>
      <span class="phase-rang" title="{{localize 'HEXAGON.Initiative.RangCalcul'}}">
        {{localize "HEXAGON.Initiative.Rang"}} <b>{{this.rang}}</b>
        {{#if this.enAttente}}<i class="phase-attente" title="{{localize 'HEXAGON.Initiative.EnAttenteAide'}}">{{localize "HEXAGON.Initiative.EnAttente"}}</i>{{/if}}
      </span>

      {{#if ../fractionnementAutorise}}
      <span class="phase-fraction">
        <input type="text" name="fraction.{{this.id}}" value="{{this.saisie}}" placeholder="{{localize 'HEXAGON.Initiative.FractionExemple'}}" />
        {{#if this.erreur}}
        <em class="phase-erreur">{{this.erreur}}</em>
        {{else if this.fractionne}}
        <em class="phase-rangs">{{localize "HEXAGON.Initiative.AgitAux"}} {{#each this.rangs}}<b>{{this}}</b>{{/each}}</em>
        {{/if}}
      </span>
      {{/if}}
    </li>
    {{/each}}
  </ul>

  <div class="phase-actions">
    <button type="button" class="hex-bouton {{#if bloc.aAppliquer}}primaire{{else}}discret{{/if}}" data-action="appliquer" data-groupe="{{bloc.groupe}}">
      {{localize "HEXAGON.Initiative.Appliquer"}}
    </button>
    <button type="button" class="hex-bouton discret" data-action="cloturerTour" data-groupe="{{bloc.groupe}}">
      {{localize "HEXAGON.Initiative.CloturerTour"}}
    </button>
  </div>
</section>
