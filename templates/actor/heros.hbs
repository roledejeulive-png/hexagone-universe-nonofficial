<form class="{{cssClass}} hexagon-form" autocomplete="off">
  {{> "systems/hexagon-universe/templates/actor/parts/header.hbs"}}

  <nav class="hex-onglets sheet-tabs" data-group="primary" aria-label="{{localize 'HEXAGON.Onglet.Titre'}}">
    <a class="hex-onglet item" data-tab="traits">{{localize "HEXAGON.Onglet.Traits"}}</a>
    <a class="hex-onglet item" data-tab="etat">{{localize "HEXAGON.Onglet.Etat"}}</a>
    <a class="hex-onglet item" data-tab="notes">{{localize "HEXAGON.Onglet.Notes"}}</a>
  </nav>

  <div class="hex-corps">
    {{> "systems/hexagon-universe/templates/actor/parts/traits.hbs"}}
    {{> "systems/hexagon-universe/templates/actor/parts/etat.hbs"}}
    {{> "systems/hexagon-universe/templates/actor/parts/notes.hbs"}}
  </div>
</form>
