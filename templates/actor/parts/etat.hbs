<section class="hex-panneau {{#if actif}}actif{{/if}}" data-panneau="etat">
  <div class="hex-groupe">
    <div class="hex-groupe-titre">
      <h2>{{localize "HEXAGON.Type.Equipement"}}</h2>
      <button type="button" class="hex-bouton discret" data-action="creerItem" data-type="equipement">
        {{localize "HEXAGON.Item.Ajouter"}}
      </button>
    </div>

    {{#if equipements.length}}
    <ul class="hex-liste">
      {{#each equipements}}
      <li class="hex-trait draggable" data-item-id="{{this.id}}">
        <span class="hex-chip statique">{{#if this.system.bonus}}{{this.system.bonus}}{{else}}·{{/if}}</span>
        <span class="hex-pas">
          <button type="button" data-action="ajusterValeur" data-champ="system.bonus" data-delta="1" title="{{localize 'HEXAGON.Valeur.Augmenter'}}">▴</button>
          <button type="button" data-action="ajusterValeur" data-champ="system.bonus" data-delta="-1" title="{{localize 'HEXAGON.Valeur.Diminuer'}}">▾</button>
        </span>
        <span class="hex-trait-nom">{{this.name}} <em>×{{this.system.quantite}}</em></span>
        <span class="hex-trait-outils">
          <button type="button" data-action="editerItem" title="{{localize 'HEXAGON.Item.Editer'}}">✎</button>
        </span>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="hex-vide">{{localize "HEXAGON.Item.Aucun"}}</p>
    {{/if}}
  </div>
</section>
