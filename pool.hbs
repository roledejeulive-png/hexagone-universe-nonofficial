<div class="hexagon-carte {{#if succes}}reussi{{else}}rate{{/if}}">
  <div class="carte-entete">
    <span class="carte-label">{{label}}</span>
    <span class="carte-pool">{{des}}d6 · {{localize "HEXAGON.Carte.Seuil"}} {{seuil}}+</span>
  </div>

  <ol class="carte-des">
    {{#each resultats}}
    <li class="de {{#if this.reussite}}reussite{{/if}} {{#if this.eclat}}eclat{{/if}}">{{this.valeur}}</li>
    {{/each}}
    {{#each specialites}}
    <li class="de auto" title="{{localize 'HEXAGON.Carte.Specialite'}} : {{this}}">★</li>
    {{/each}}
  </ol>

  <div class="carte-bilan">
    <span class="bilan-chiffre">{{reussites}}</span>
    <span class="bilan-texte">
      {{localize "HEXAGON.Carte.Reussites"}}
      <em>{{localize "HEXAGON.Carte.Contre"}} {{difficulte}}</em>
    </span>
    <span class="bilan-verdict">
      {{#if succes}}{{localize "HEXAGON.Carte.Succes"}}{{else}}{{localize "HEXAGON.Carte.Echec"}}{{/if}}
      {{#if marge}}<em>({{localize "HEXAGON.Carte.Marge"}} {{marge}})</em>{{/if}}
    </span>
  </div>

  {{#if auto}}
  <p class="carte-auto">
    {{reussitesDes}} {{localize "HEXAGON.Carte.SurLesDes"}} + {{auto}} {{localize "HEXAGON.Carte.Auto"}}
    {{#each specialites}}<span class="pool-tag">{{this}}</span>{{/each}}
  </p>
  {{/if}}

  {{#if eclats}}
  <p class="carte-eclats">{{localize "HEXAGON.Carte.Eclats"}} : {{eclats}}</p>
  {{/if}}

  {{#if detail.length}}
  <p class="carte-detail">
    {{#each detail}}<span class="pool-tag">{{this.nom}} {{this.rang}}</span>{{/each}}
  </p>
  {{/if}}
</div>
